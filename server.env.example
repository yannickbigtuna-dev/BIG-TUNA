# ── apps-server environment ──────────────────────────────────────────────────
# Copy this file to `server.env` (same folder) and fill in the values.
# `server.env` is gitignored — never commit real keys.
# Apply changes with:  pm2 restart ecosystem.config.cjs --update-env

# Public site URL — used to build the YES/NO/NEVER links in coaching emails.
PUBLIC_BASE_URL=https://yannickmorgans.ca

# Trivia generation (OpenAI GPT-5.6 Luna)
# Server-side only. Used for typed-topic generation and for intentionally
# regenerating the committed 1,000-question Trivia bank. API billing is
# separate from ChatGPT subscriptions. The Trivia model is fixed in code.
OPENAI_API_KEY=replace-with-openai-api-key

# ── AI coaching (Anthropic, Claude Opus 4.8) ────────────────────────────────
# Get from https://console.anthropic.com  →  Settings  →  API keys  →  Create key.
# Starts with "sk-ant-". Requires billing/credits on the Anthropic account.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — defaults to claude-opus-4-8 if omitted.
ANTHROPIC_MODEL=claude-opus-4-8

# ── Email delivery (Resend) ─────────────────────────────────────────────────
# Get the key from https://resend.com  →  API Keys  →  Create API Key.
# Starts with "re_".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The "from" address. Its domain must be VERIFIED in Resend
# (resend.com → Domains → Add Domain → add the DNS records it shows).
# e.g. coach@yannickmorgans.ca
ASSIGNMENTS_FROM_EMAIL=coach@yannickmorgans.ca

# ── Secrets (generate once, then never change) ──────────────────────────────
# Encrypts each user's stored Brightspace password (AES-256-GCM) and signs the
# email action links. If you change these later, existing saved passwords can no
# longer be decrypted (users just re-enter them) and old email links stop working.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ASSIGNMENTS_CRYPTO_SECRET=
ASSIGNMENTS_ACTION_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Hour (server local time, 0–23) to send the morning coaching email. Default 6.
ASSIGNMENTS_DAILY_HOUR=6

# ── Yannick vs Emma Strava Challenge ────────────────────────────────────────
# Create an application at https://www.strava.com/settings/api. Keep the client
# secret server-side only; do not expose it in browser code or commit it.
STRAVA_CLIENT_ID=replace-with-strava-client-id
STRAVA_CLIENT_SECRET=replace-with-strava-client-secret
STRAVA_REDIRECT_URI=https://yannickmorgans.ca/api/strava-challenge/oauth/callback
# Public URL used for invitation/result links. Falls back to PUBLIC_BASE_URL.
CHALLENGE_BASE_URL=https://yannickmorgans.ca
# Challenge configuration and private participant delivery addresses.
STRAVA_CHALLENGE_YEAR=2026
STRAVA_CHALLENGE_START_DATE=2026-01-01
STRAVA_CHALLENGE_YANNICK_EMAIL=yannick@example.com
STRAVA_CHALLENGE_EMMA_EMAIL=emma@example.com
# Generate once and retain: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
STRAVA_CHALLENGE_CRYPTO_SECRET=
# Optional operational settings. Competition boundaries are America/Halifax.
STRAVA_CHALLENGE_INVITE_TTL_HOURS=168
STRAVA_CHALLENGE_SYNC_INTERVAL_MINUTES=30
STRAVA_CHALLENGE_FINALIZE_HOUR=8
# Optional sender override for Challenge emails; otherwise ASSIGNMENTS_FROM_EMAIL.
STRAVA_CHALLENGE_FROM_EMAIL=strava-challenge@yannickmorgans.ca
# Set only after Strava has approved the authorized public display/retention use.
STRAVA_CHALLENGE_DISCLOSURE_APPROVED=true

# â”€â”€ Apple App Factory private release catalogue â”€â”€
# Releases are served only through authenticated API routes, never as public
# static files. Set the exact existing BIG TUNA username allowed to view and
# download releases. Leaving this blank disables the catalogue.
APPLE_APP_FACTORY_OWNER_USERNAME=
# Optional absolute, gitignored release root. Leave blank to use
# data/apple-app-factory/releases. Do not point this at apps/ or the repository.
APPLE_APP_FACTORY_RELEASE_ROOT=
# These are only consumed by the optional local deployment helper; use a
# restricted SSH key permitted to write the release directory only.
APPLE_APP_FACTORY_DEPLOY_HOST=
APPLE_APP_FACTORY_DEPLOY_USER=
APPLE_APP_FACTORY_DEPLOY_ROOT=
APPLE_APP_FACTORY_DEPLOY_SSH_KEY_PATH=
